# Line endings that must not be converted by git on Windows (autocrlf), or the scripts break.
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf
# A CRLF Dockerfile or compose file breaks the shell lines inside it.
Dockerfile text eol=lf
.dockerignore text eol=lf
docker-compose.yml text eol=lf
*.ps1 text eol=crlf
# The fixtures shared by the TypeScript and C# tests stay byte-identical on every platform.
unity/Packages/com.mira.stage/Tests~/golden/** text eol=lf
