# Copy to .env (never commit .env). Nothing here is needed for the mockup.

# Claude connection mode for daemon-launched sessions (Phase 1+)
#   api-key      -> uses ANTHROPIC_API_KEY (terms-safe default)
#   local-login  -> drives your own logged-in `claude` binary (personal use; see docs/adr/0001)
CLAUDE_AUTH_MODE=api-key
ANTHROPIC_API_KEY=

# Daemon (Phase 1+). Binds to loopback only.
DAEMON_PORT=7421
VAULT_DIR=
